# Postgres connection string used by the app and by drizzle-kit migrations.
# Local dev: `docker compose up -d` starts a matching database on this URL.
DATABASE_URL=postgresql://stackboard:stackboard@localhost:5432/stackboard

# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-byte-secret

# Base URL used to build absolute links in invite emails.
APP_URL=http://localhost:3000

# Resend (https://resend.com) is used to deliver invite emails.
# Leave RESEND_API_KEY unset in development: the email adapter falls back to
# logging the message to the console instead of sending it.
RESEND_API_KEY=
EMAIL_FROM=Stackboard <onboarding@resend.dev>

# Host interface and port that docker-compose.prod.yml publishes `web` on.
# Defaults bind to loopback so a deploy is never served to the internet
# without TLS — put a reverse proxy (Traefik, nginx, Caddy) in front and have
# it forward to 127.0.0.1:3000. Set WEB_BIND=0.0.0.0 only if you deliberately
# want the app reachable unproxied. Ignored outside docker-compose.prod.yml.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# S3-compatible object storage for attachments (MinIO in production — see
# docker-compose.prod.yml). Leave S3_ENDPOINT unset in development: attachments
# fall back to local disk under UPLOAD_DIR (default ./var/uploads) instead.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
