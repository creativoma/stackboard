# Postgres connection string used by the app and by drizzle-kit migrations.
# Local dev: `docker compose up -d` starts a matching database on this URL.
DATABASE_URL=postgresql://stackboard:stackboard@localhost:5432/stackboard

# Reserved for a future move to signed/stateless sessions — nothing reads it
# yet. Today's sessions are opaque random tokens stored (SHA-256 hashed) in the
# database, see lib/auth/session.ts. Kept here so the variable is already in
# place when that lands. Generate a value with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-byte-secret

# Base URL used to build absolute links in invite emails.
APP_URL=http://localhost:3000

# Resend (https://resend.com) is used to deliver invite emails.
# Leave RESEND_API_KEY unset in development: the email adapter falls back to
# logging the message to the console instead of sending it.
RESEND_API_KEY=
EMAIL_FROM=Stackboard <onboarding@resend.dev>

# Directory for attachment bytes via the local-disk storage adapter
# (lib/storage/local.ts), used when S3_ENDPOINT below is unset.
# UPLOAD_DIR=./var/uploads

# S3-compatible object storage for attachments (MinIO in production — see
# docker-compose.prod.yml). Leave S3_ENDPOINT unset in development: attachments
# fall back to local disk under UPLOAD_DIR (default ./var/uploads) instead.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# ── docker-compose.prod.yml only ─────────────────────────────────────────────
# The variables below are read by docker-compose.prod.yml, not by the app
# itself. Set real values in your deploy platform's env panel (or an env file
# kept out of git) — see docs/deployment.md.

# Host interface and port that docker-compose.prod.yml publishes `web` on.
# Defaults bind to loopback so a deploy is never served to the internet
# without TLS — put a reverse proxy (Traefik, nginx, Caddy) in front and have
# it forward to 127.0.0.1:3000. Set WEB_BIND=0.0.0.0 only if you deliberately
# want the app reachable unproxied.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# Postgres superuser password for the compose `db` service. ⚠️ Only applied on
# first init of an empty data volume — rotating it later also requires an
# ALTER USER against the running database (see docs/deployment.md).
POSTGRES_PASSWORD=change_me

# MinIO root credentials for the compose `minio` service. The compose file
# wires these same values into the app's S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY.
MINIO_ROOT_USER=stackboard
MINIO_ROOT_PASSWORD=change_me
